# Environment Configuration for Ado-dad Application
# Copy this file to .env and fill in your actual values

# ===========================================
# APPLICATION CONFIGURATION
# ===========================================
NODE_ENV=development
BACKEND_PORT=3000
APP_CONFIG__BACKEND_PORT=3000

# Comma-separated list of origins allowed to call the API.
# REQUIRED when NODE_ENV=production — the app refuses to boot without it
# (P0-5). Leave unset in development to allow any origin.
# Credentials are only sent when this list is set.
CORS_ORIGINS=https://app.example.com,https://admin.example.com

# Number of reverse proxies in front of the app (nginx / ALB / Cloudflare).
# 0 = the app is exposed directly. Anything above 0 makes Express trust that
# many hops of X-Forwarded-For, which is what per-IP rate limiting (P0-2)
# relies on. Do NOT raise this unless a proxy really is in front — a client
# can forge X-Forwarded-For otherwise.
TRUST_PROXY_HOPS=0

# ===========================================
# DATABASE CONFIGURATION
# ===========================================

# MongoDB Configuration (Choose one method)

# Method 1: Direct MongoDB URI (Preferred)
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/ado-dad?retryWrites=true&w=majority&appName=Cluster0

# Method 2: Alternative Manual Configuration (if not using URI)
# MONGO_USER=mongodbuser
# MONGO_PASSWORD=your-mongodb-password
# MONGO_HOST=localhost
# MONGO_PORT=27017
# MONGO_DATABASE=ado-dad

# Alternative MongoDB Connection Examples (commented out)
# MONGO_URI=mongodb://username:password@developmongo.cluster-cvkaq4a0w63h.ap-south-1.docdb.amazonaws.com:27017/?tls=true&tlsCAFile=global-bundle.pem&replicaSet=rs0&readPreference=secondaryPreferred&retryWrites=false
# MONGO_URI=mongodb://13.126.129.26:27017/ado-dad?directConnection=true&serverSelectionTimeoutMS=2000&appName=mongosh+2.3.7

# -------------------------------------------
# DATABASE SAFETY  (see docs/search_prod_safety.md)
# -------------------------------------------

# Which database this env file points at: local | uat | staging | production.
# SET THIS IN EVERY ENV FILE. When it is missing, the write fuse falls back to
# heuristics on the host and database name, and anything it cannot positively
# identify as non-production is treated as PRODUCTION. Note that the URI above
# ("cluster.mongodb.net/ado-dad") carries no marker either way, so without this
# line it classifies as production — safe, but you should not rely on it.
DB_ENVIRONMENT=local

# Mongoose builds every schema.index() declaration on boot when this is true.
# Off by default outside local: an index build on a live collection must be a
# decision (npm run search:indexes), never a side effect of a deploy.
# MONGO_AUTO_INDEX=true

# Third key required by maintenance scripts before they may write to a database
# classified as production. Leave unset. Set it inline for a single command:
#   ALLOW_PROD_WRITE=yes npm run search:seed -- --apply --prod --confirm <db>
# ALLOW_PROD_WRITE=yes

# -------------------------------------------
# SEARCH
# -------------------------------------------

# Turns on query understanding: "cars in kollam" becomes category=private_vehicle
# + location=Kollam instead of a raw $text match that also hits property ads
# mentioning "car parking". Requires the lexicon to be seeded first
# (npm run search:seed). Unset it to revert to the old behaviour without a deploy.
# SEARCH_PARSER_ENABLED=true

# -------------------------------------------
# DATABASE SAFETY (continued)
# -------------------------------------------

# Optional explicit classification when host/database names carry no marker.
# Comma-separated, matched case-insensitively against host:port or db name.
# PROD_DB_HOSTS=cluster.mongodb.net
# PROD_DB_NAMES=ado-dad
# NONPROD_DB_HOSTS=uat-cluster.mongodb.net
# NONPROD_DB_NAMES=ado-dad-uat

# ===========================================
# REDIS CONFIGURATION
# ===========================================

# Redis Configuration (Choose one method)

# Method 1: Redis URL (Preferred)
REDIS_URL=redis://localhost:6379

# Method 2: Individual Redis Settings (for external Redis)
# REDIS_HOST=your-redis-host.com
# REDIS_PORT=6379
# REDIS_PASSWORD=your-redis-password
# REDIS_DB=0

# ===========================================
# AUTHENTICATION & SECURITY
# ===========================================
JWT_SECRET=your-super-secret-jwt-key-change-in-production
TOKEN_KEY=your-token-encryption-key
SALT_ROUNDS=10
ACCESS_TOKEN_EXPIRY=1m
REFRESH_TOKEN_EXPIRY=4m

# ===========================================
# AWS CONFIGURATION
# ===========================================
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=ap-south-1
AWS_S3_BUCKET_NAME=your-s3-bucket-name

# ===========================================
# FIREBASE CONFIGURATION
# ===========================================
FIREBASE_SA_JSON=file.json
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=your-client-email
FIREBASE_PRIVATE_KEY="your-private-key"
FIREBASE_API_KEY=your-api-key
FIREBASE_MESSAGING_SENDER_ID=your-sender-id
FIREBASE_APP_ID=your-app-id
FIREBASE_VAPID_KEY=your-vapid-key

# ===========================================
# EMAIL CONFIGURATION
# ===========================================
# Password Reset Configuration
RESET_LINK=https://adodad.com/reset-password?token=
SES_FROM_EMAIL=support@adodad.com
EMAIL_SENDER_NAME=AdoDad
FRONTEND_URL=https://adodad.com

# ===========================================
# GOOGLE MAPS CONFIGURATION
# ===========================================
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
API_KEY_MAPS=your-google-maps-api-key
API_SECRET_MAPS=your-google-maps-api-secret

# ===========================================
# MSG91 SMS CONFIGURATION
# ===========================================
MSG91_AUTHKEY=your-msg91-auth-key
MSG91_TEMPLATE_ID=your-msg91-template-id
MSG91_SHORT_URL=0
MSG91_SHORT_URL_EXPIRY=
