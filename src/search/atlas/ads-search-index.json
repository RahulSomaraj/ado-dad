        "sellerVerified": { "type": "boolean" },
        "price": { "type": "number" },
        "vehicleYear": { "type": "number" },
        "bedrooms": { "type": "number" },
        "areaSqft": { "type": "number" },
        "imageCount": { "type": "number" },
